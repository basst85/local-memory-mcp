# Ollama endpoint and embedding model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma

# SQLite database path
MEMORY_DB_PATH=./data/memory.db

# Logical partition key for memories (use project-specific values if desired)
WORKSPACE_KEY=default

# Optional: override embedding dimensions if your model differs
EMBEDDING_DIM=768

# Optional (mainly macOS): custom SQLite library path when extension loading fails
# CUSTOM_SQLITE_PATH=/path/to/libsqlite3.dylib
